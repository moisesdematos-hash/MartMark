# Public values may be used by browser code only when explicitly prefixed as public.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Leave empty until the corresponding phase and environment exist.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PROXYPAY_TOKEN=
PROXYPAY_ENTITY=
PROXYPAY_WEBHOOK_SECRET=
PROXYPAY_API_URL=
RESEND_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=

# Never expose server secrets through NEXT_PUBLIC_* or browser bundles.
